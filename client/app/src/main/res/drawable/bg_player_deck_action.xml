<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/pluxyGlassFocusTop" />
            <stroke android:width="2dp" android:color="?attr/pluxyAccentBright" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="?attr/pluxyGlassFocusTop" android:endColor="?attr/pluxyGlassFocusBottom" />
            <stroke android:width="2dp" android:color="?attr/pluxyBorderFocus" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/pluxyAmbientCoralTrans" />
            <stroke android:width="1dp" android:color="?attr/pluxyBorder" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
