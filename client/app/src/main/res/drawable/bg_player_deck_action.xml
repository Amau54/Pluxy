<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/pluxyGlassFocusTop" />
                <stroke android:width="1dp" android:color="?attr/pluxyAccentBright" />
                <corners android:radius="8dp" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/pluxyGlassFocusTop" />
                <stroke android:width="1.5dp" android:color="?attr/pluxyBorderFocus" />
                <corners android:radius="8dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
