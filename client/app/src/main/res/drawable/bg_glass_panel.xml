<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent graphite plus one fine reflection; cheap to draw on older TVs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/pluxyGlassTop" />
            <corners android:radius="@dimen/radius_lg" />
            <stroke android:width="0.5dp" android:color="?attr/pluxyBorder" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top"
        android:left="18dp" android:right="18dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/pluxyGlassGlintTrans" />
        </shape>
    </item>
</layer-list>
