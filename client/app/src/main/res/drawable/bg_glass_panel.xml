<?xml version="1.0" encoding="utf-8"?>
<!-- Translucent graphite plus one fine reflection; cheap to draw on older TVs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315"
                android:startColor="?attr/pluxyGlassTop" android:endColor="?attr/pluxyGlassBottom" />
            <corners android:radius="@dimen/radius_lg" />
            <stroke android:width="1dp" android:color="?attr/pluxyBorder" />
        </shape>
    </item>
    <item android:height="1dp" android:gravity="top"
        android:left="18dp" android:right="18dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="?attr/pluxyGlassGlintTrans"
                android:centerColor="?attr/pluxyGlassGlint" android:endColor="?attr/pluxyGlassGlintTrans" />
        </shape>
    </item>
</layer-list>
