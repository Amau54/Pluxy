<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="?attr/pluxyAccentDim" />
            <stroke android:width="3dp" android:color="?attr/pluxyAccentBright" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="?attr/pluxyGlowEdge" />
                    <stroke android:width="2dp" android:color="?attr/pluxyTextPrimary" />
                </shape>
            </item>
            <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
                <shape android:shape="oval">
                    <gradient android:angle="315" android:startColor="?attr/pluxyAccentBright" android:endColor="?attr/pluxyAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="?attr/pluxyAccentBright" android:endColor="?attr/pluxyAccent" />
            <stroke android:width="1dp" android:color="?attr/pluxyGlassGlint" />
        </shape>
    </item>
</selector>
