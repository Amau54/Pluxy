<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:inset="6dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/pluxyGlassFocusTop" />
                <stroke android:width="1dp" android:color="?attr/pluxyAccentBright" />
                <corners android:radius="@dimen/radius_md" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:inset="6dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/pluxyGlassFocusTop" />
                <stroke android:width="1.5dp" android:color="?attr/pluxyBorderFocus" />
                <corners android:radius="@dimen/radius_md" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="8dp">
            <shape android:shape="rectangle">
                <solid android:color="#20FFFFFF" />
                <corners android:radius="@dimen/radius_md" />
            </shape>
        </inset>
    </item>
</selector>
