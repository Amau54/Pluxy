<?xml version="1.0" encoding="utf-8"?>
<!-- The primary action carries the coral accent; focus remains unmistakable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/accent_bright" android:endColor="@color/accent" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_dim" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/accent" android:endColor="#EBA080" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
