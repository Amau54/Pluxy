<?xml version="1.0" encoding="utf-8"?>
<!-- Accent réservé à l’action principale. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetTop="4dp" android:insetBottom="4dp">
<selector>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/pluxyAccentBright" />
            <stroke android:width="2dp" android:color="?attr/pluxyTextPrimary" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/pluxyAccentDim" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/pluxyAccent" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
</inset>
