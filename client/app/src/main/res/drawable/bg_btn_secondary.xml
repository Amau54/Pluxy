<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary actions keep their smoked surface; focus uses a clear warm edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/glass_focus_top" android:endColor="@color/glass_focus_bottom" />
            <stroke android:width="2dp" android:color="@color/border_focus" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_focus" />
            <stroke android:width="1dp" android:color="@color/accent_bright" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/glass_top" android:endColor="@color/glass_bottom" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</selector>
