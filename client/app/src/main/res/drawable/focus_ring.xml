<?xml version="1.0" encoding="utf-8"?>
<!-- Anneau de focus transparent (posé en foreground sur une image arrondie). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="4dp" android:color="?attr/pluxyGlowEdge" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke android:width="@dimen/focus_stroke" android:color="?attr/pluxyBorderFocus" />
                    <corners android:radius="@dimen/radius_md" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
