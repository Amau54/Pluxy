<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <gradient android:angle="315" android:startColor="@color/glass_focus_top" android:endColor="@color/glass_focus_bottom" />
            <stroke android:width="2dp" android:color="@color/border_focus" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <gradient android:angle="315" android:startColor="#E92A303B" android:endColor="#D91C232E" />
            <stroke android:width="1dp" android:color="@color/glow_edge" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <gradient android:angle="315" android:startColor="@color/glass_focus_top" android:endColor="@color/glass_focus_bottom" />
            <stroke android:width="2dp" android:color="@color/border_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_md" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
