<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:inset="6dp">
    <selector>
        <item android:state_focused="true">
            <shape><corners android:radius="10dp" /><solid android:color="?attr/pluxySurfaceFocus" /><stroke android:width="2dp" android:color="?attr/pluxyBorderFocus" /></shape>
        </item>
        <item android:state_pressed="true">
            <shape><corners android:radius="10dp" /><solid android:color="?attr/pluxySurfaceFocus" /></shape>
        </item>
        <item><shape><solid android:color="@android:color/transparent" /></shape></item>
    </selector>
</inset>
