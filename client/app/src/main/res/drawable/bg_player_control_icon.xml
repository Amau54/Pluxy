<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:inset="5dp">
            <shape android:shape="oval">
                <solid android:color="?attr/pluxySurfaceFocus" />
                <stroke android:width="2dp" android:color="?attr/pluxyAccentBright" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:inset="4dp">
            <shape android:shape="oval">
                <gradient android:angle="315" android:startColor="?attr/pluxyGlassFocusTop" android:endColor="?attr/pluxyGlassFocusBottom" />
                <stroke android:width="2dp" android:color="?attr/pluxyBorderFocus" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="7dp">
            <shape android:shape="oval">
                <gradient android:angle="315" android:startColor="?attr/pluxyGlassTop" android:endColor="?attr/pluxyGlassBottom" />
                <stroke android:width="1dp" android:color="?attr/pluxyBorder" />
            </shape>
        </inset>
    </item>
</selector>
