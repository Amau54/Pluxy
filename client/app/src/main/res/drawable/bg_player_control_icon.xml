<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset android:inset="5dp">
            <shape android:shape="oval">
                <solid android:color="@color/surface_focus" />
                <stroke android:width="2dp" android:color="@color/accent_bright" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:inset="4dp">
            <shape android:shape="oval">
                <gradient android:angle="315" android:startColor="@color/glass_focus_top" android:endColor="@color/glass_focus_bottom" />
                <stroke android:width="2dp" android:color="@color/border_focus" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="7dp">
            <shape android:shape="oval">
                <gradient android:angle="315" android:startColor="@color/glass_top" android:endColor="@color/glass_bottom" />
                <stroke android:width="1dp" android:color="@color/border" />
            </shape>
        </inset>
    </item>
</selector>
