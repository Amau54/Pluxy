<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="?attr/pluxyAccentDim" />
            <stroke android:width="3dp" android:color="?attr/pluxyAccentBright" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="?attr/pluxyAccentBright" />
            <stroke android:width="3dp" android:color="?attr/pluxyTextPrimary" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="?attr/pluxyAccent" android:endColor="?attr/pluxyAccentDim" />
        </shape>
    </item>
</selector>
