<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@android:color/transparent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/radius_sm" />
            <solid android:color="?attr/pluxyGlassFocusBottom" />
            <stroke android:width="1dp" android:color="?attr/pluxyBorderFocus" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/radius_sm" />
            <solid android:color="?attr/pluxyGlassFocusBottom" />
            <stroke android:width="1dp" android:color="?attr/pluxyBorderFocus" />
        </shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /></shape></item>
</selector>
