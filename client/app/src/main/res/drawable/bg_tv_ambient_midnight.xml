<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#15171C" />
        </shape>
    </item>
    <item android:gravity="top|right" android:right="-180dp" android:top="-220dp">
        <shape android:shape="oval">
            <size android:width="620dp" android:height="620dp" />
            <solid android:color="#0AC4CFEB" />
        </shape>
    </item>
    <item android:gravity="bottom|left" android:left="-180dp" android:bottom="-250dp">
        <shape android:shape="oval">
            <size android:width="560dp" android:height="560dp" />
            <solid android:color="#06A2AAC0" />
        </shape>
    </item>
</layer-list>
