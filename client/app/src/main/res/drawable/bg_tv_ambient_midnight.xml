<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#15171C"
                android:centerColor="#050608"
                android:endColor="#FF050608" />
        </shape>
    </item>
    <item android:gravity="top|right" android:right="-180dp" android:top="-220dp">
        <shape android:shape="oval">
            <size android:width="620dp" android:height="620dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="310dp"
                android:startColor="#0AC4CFEB"
                android:endColor="#00C4CFEB" />
        </shape>
    </item>
    <item android:gravity="bottom|left" android:left="-180dp" android:bottom="-250dp">
        <shape android:shape="oval">
            <size android:width="560dp" android:height="560dp" />
            <gradient android:type="radial" android:gradientRadius="280dp"
                android:startColor="#06A2AAC0" android:endColor="#00A2AAC0" />
        </shape>
    </item>
</layer-list>
