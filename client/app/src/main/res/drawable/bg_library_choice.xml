<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetTop="6dp" android:insetBottom="6dp">
    <selector>
        <item android:state_focused="true">
            <shape><corners android:radius="@dimen/radius_md" /><solid android:color="?attr/pluxySurfaceFocus" /><stroke android:width="2dp" android:color="?attr/pluxyBorderFocus" /></shape>
        </item>
        <item android:state_pressed="true">
            <shape><corners android:radius="@dimen/radius_md" /><solid android:color="?attr/pluxySurfaceFocus" /></shape>
        </item>
        <item>
            <shape><corners android:radius="@dimen/radius_md" /><solid android:color="?attr/pluxySurface" /><stroke android:width="1dp" android:color="?attr/pluxyBorderSubtle" /></shape>
        </item>
    </selector>
</inset>
