<?xml version="1.0" encoding="utf-8"?>
<!-- Relief très discret, proche d'une navigation web CSS plutôt que d'un bouton TV massif. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.006"
                android:valueType="floatType" android:duration="130" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.006"
                android:valueType="floatType" android:duration="130" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="6dp"
                android:valueType="floatType" android:duration="130" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0"
                android:valueType="floatType" android:duration="130" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0"
                android:valueType="floatType" android:duration="130" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp"
                android:valueType="floatType" android:duration="130" />
        </set>
    </item>
</selector>
