<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="auxiliary_audio_cover_size">112dp</dimen>
    <dimen name="auxiliary_audio_title_size">22sp</dimen>
    <dimen name="auxiliary_viewer_pad">20dp</dimen>
    <dimen name="auxiliary_meta_size">14sp</dimen>

    <style name="AuxiliaryViewer.Icon" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_auxiliary_action</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:tint">?attr/pluxyTextPrimary</item>
    </style>

    <style name="AuxiliaryViewer.Action" parent="Btn.Secondary">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">@dimen/auxiliary_meta_size</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">@drawable/bg_auxiliary_action</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
