<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="player_edge_gap">12dp</dimen>
    <dimen name="player_deck_padding">12dp</dimen>
    <dimen name="player_icon_size">48dp</dimen>
    <dimen name="player_primary_size">48dp</dimen>
    <dimen name="player_title_size">14sp</dimen>
    <dimen name="player_time_size">12sp</dimen>
    <dimen name="player_deck_max_width">640dp</dimen>
    <style name="PlayerDeck" />
    <style name="PlayerDeck.Icon">
        <item name="android:layout_width">@dimen/player_icon_size</item>
        <item name="android:layout_height">@dimen/player_icon_size</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_player_deck_icon</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">13dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:tint">?attr/pluxyTextPrimary</item>
    </style>
    <style name="PlayerDeck.Primary" parent="PlayerDeck.Icon">
        <item name="android:layout_width">@dimen/player_primary_size</item>
        <item name="android:layout_height">@dimen/player_primary_size</item>
        <item name="android:background">@drawable/bg_player_deck_primary</item>
        <item name="android:padding">13dp</item>
        <item name="android:tint">?attr/pluxyTextPrimary</item>
    </style>
    <style name="PlayerDeck.Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:background">@drawable/bg_player_deck_action</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">?attr/pluxyTextPrimary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/pluxyTextPrimary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
