<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pluxy" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ===================== Typographie ===================== -->
    <!-- Base implicite des styles Text.* (requise par la notation pointée). -->
    <style name="Text" />

    <style name="Text.Display">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Heading">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ===================== Boutons ===================== -->
    <style name="Btn">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/btn_min_h</item>
        <item name="android:minWidth">128dp</item>
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:focusable">true</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@animator/focus_lift_btn</item>
    </style>

    <style name="Btn.Primary" parent="Btn">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/text_on_accent</item>
    </style>

    <style name="Btn.Secondary" parent="Btn">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/btn_secondary_text</item>
    </style>

    <style name="Btn.Tab" parent="Btn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:stateListAnimator">@animator/focus_lift_tab</item>
    </style>

    <!-- Actions d'en-tête : compactes, lisibles et secondaires par rapport au catalogue. -->
    <style name="Btn.Icon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@drawable/bg_btn_icon</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">10dp</item>
        <item name="android:stateListAnimator">@animator/focus_lift_btn</item>
    </style>

    <!-- Choix contextualisé en en-tête : visible seulement pour la photothèque TV. -->
    <style name="Btn.TopBarChoice">
        <item name="android:layout_width">124dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@drawable/bg_btn_topbar_choice</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@animator/focus_lift_btn</item>
    </style>

    <!-- Contrôles du lecteur TV : cibles >= 52 dp, focus très visible et aucun
         padding hérité des boutons Android susceptible de couper le texte. -->
    <style name="PlayerControl">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minWidth">76dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/bg_player_control</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:stateListAnimator">@animator/focus_lift_btn</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/player_control_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="PlayerControl.Secondary" parent="PlayerControl" />

    <style name="PlayerControl.Icon">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_player_control_icon</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">15dp</item>
        <item name="android:stateListAnimator">@animator/focus_lift_btn</item>
        <item name="android:tint">@color/player_control_text</item>
    </style>

    <style name="PlayerControl.Compact" parent="PlayerControl">
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PlayerControl.Primary">
        <item name="android:layout_width">66dp</item>
        <item name="android:layout_height">66dp</item>
        <item name="android:background">@drawable/bg_player_control_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">19dp</item>
        <item name="android:stateListAnimator">@animator/focus_lift_btn</item>
        <item name="android:tint">@color/player_primary_icon</item>
    </style>
</resources>
