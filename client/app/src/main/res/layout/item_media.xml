<?xml version="1.0" encoding="utf-8"?>
<!-- Carte média adaptative : affiche 2:3, capture vidéo 16:9 ou pochette carrée. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:orientation="vertical">

    <com.pluxy.tv.ui.RoundedArtworkFrame
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/poster_rounded"
        android:clipToOutline="true"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:duplicateParentState="true"
        android:foreground="@drawable/focus_ring"
        android:stateListAnimator="@animator/focus_lift">

        <com.pluxy.tv.ui.PosterImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/poster_rounded"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/hdrBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_chip_accent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/label_hdr"
            android:textColor="?attr/pluxyAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:visibility="gone" />

        <!-- Marqueur « déjà vu » (persistant via le serveur) -->
        <TextView
            android:id="@+id/watchedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_chip_watched"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="@string/label_watched"
            android:textColor="?attr/pluxySuccess"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Barre de reprise (films commencés mais non terminés) -->
        <ProgressBar
            android:id="@+id/resumeBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:max="100"
            android:progressDrawable="@drawable/resume_progress"
            android:visibility="gone" />
    </com.pluxy.tv.ui.RoundedArtworkFrame>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:ellipsize="end"
        android:minLines="1"
        android:maxLines="2"
        android:textColor="?attr/pluxyTextPrimary"
        android:textSize="@dimen/card_title_size"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/pluxyTextTertiary"
        android:textSize="@dimen/card_meta_size"
        android:letterSpacing="0" />
</LinearLayout>
