<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/pluxyAmbientBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/auxiliary_viewer_pad">

        <ImageView
            android:id="@+id/audioCover"
            android:layout_width="@dimen/auxiliary_audio_cover_size"
            android:layout_height="@dimen/auxiliary_audio_cover_size"
            android:background="@drawable/poster_rounded"
            android:clipToOutline="true"
            android:contentDescription="@string/description_audio_cover"
            android:elevation="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_music_placeholder" />

        <TextView
            android:id="@+id/audioTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?attr/pluxyTextPrimary"
            android:textSize="@dimen/auxiliary_audio_title_size"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/audioMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="?attr/pluxyTextSecondary"
            android:textSize="@dimen/auxiliary_meta_size" />

        <ProgressBar
            android:id="@+id/audioLoading"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:indeterminateTint="?attr/pluxyAccent" />

        <TextView
            android:id="@+id/audioError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="?attr/pluxyTextSecondary"
            android:textSize="@dimen/auxiliary_meta_size"
            android:visibility="gone" />

        <androidx.media3.ui.PlayerControlView
            android:id="@+id/audioControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:focusable="true"
            app:controller_layout_id="@layout/audio_compact_controls"
            app:play_icon="@drawable/ic_player_play"
            app:pause_icon="@drawable/ic_player_pause"
            app:previous_icon="@drawable/ic_player_previous"
            app:next_icon="@drawable/ic_player_next"
            app:rewind_icon="@drawable/ic_player_rewind"
            app:fastforward_icon="@drawable/ic_player_forward"
            app:animation_enabled="false"
            app:show_fastforward_button="true"
            app:show_next_button="true"
            app:show_previous_button="true"
            app:show_rewind_button="true"
            app:show_shuffle_button="false"
            app:show_subtitle_button="false"
            app:show_timeout="0" />

        <LinearLayout
            android:id="@+id/audioActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/audioQueue"
                style="@style/AuxiliaryViewer.Icon"
                android:src="@drawable/ic_auxiliary_queue"
                android:contentDescription="@string/audio_queue_title"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/audioStop"
                style="@style/AuxiliaryViewer.Icon"
                android:src="@drawable/ic_auxiliary_stop"
                android:contentDescription="@string/audio_stop" />
        </LinearLayout>

        <Button
            android:id="@+id/audioRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_secondary"
            android:minHeight="48dp"
            android:paddingHorizontal="24dp"
            android:stateListAnimator="@animator/focus_lift_btn"
            android:text="@string/action_retry"
            android:textAllCaps="false"
            android:textColor="?attr/pluxyTextPrimary"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
