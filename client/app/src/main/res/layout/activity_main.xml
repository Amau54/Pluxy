<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/pluxyAmbientBackground"
    android:paddingTop="@dimen/library_top_pad"
    android:paddingBottom="@dimen/library_bottom_pad">

    <!-- Barre de titre : logo + « Pluxy » (gauche, fixe) · serveur (centre, extensible)
         · boutons icône (droite, largeur constante). -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/library_toolbar_height"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/brandLogo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/pluxy_logo"
                android:contentDescription="@string/brand_pluxy" />

            <TextView
                android:id="@+id/brandName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_pluxy"
                android:textColor="?attr/pluxyTextPrimary"
                android:textSize="20sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="normal"
                android:letterSpacing="0.01" />
        </LinearLayout>

        <TextView
            android:id="@+id/serverLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp"
            android:drawablePadding="6dp"
            android:textColor="?attr/pluxyTextTertiary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/photoFolders"
            style="@style/Btn.TopBarChoice"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_library_choice"
            android:drawableEnd="@drawable/ic_library_dropdown"
            android:drawablePadding="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:stateListAnimator="@null"
            android:contentDescription="@string/action_choose_photo_folder"
            android:text="@string/photo_folder_all"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/search"
            style="@style/Btn.Icon"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_library_icon"
            android:stateListAnimator="@null"
            android:contentDescription="@string/action_search_all"
            android:scaleType="center"
            android:src="@drawable/ic_search"
            app:tint="?attr/pluxyTextPrimary" />

        <Button
            android:id="@+id/sortFilter"
            style="@style/Btn.TopBarChoice"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_library_choice"
            android:stateListAnimator="@null"
            android:contentDescription="@string/action_sort_filter"
            android:text="Trier"
            android:visibility="gone" />

        <Button
            android:id="@+id/settings"
            style="@style/Btn.Tab"
            android:background="@drawable/bg_library_icon"
            android:stateListAnimator="@null"
            android:text="Paramètres"
            android:contentDescription="@string/action_settings" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/categoryNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginTop="@dimen/library_navigation_top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <HorizontalScrollView
            android:id="@+id/categoryScroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/tabHome"
                    style="@style/Btn.Tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:minWidth="64dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/destination_home" />

                <Button
                    android:id="@+id/tabMovies"
                    style="@style/Btn.Tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginStart="2dp"
                    android:minWidth="64dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/destination_movies" />

                <Button
                    android:id="@+id/tabSeries"
                    style="@style/Btn.Tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginStart="2dp"
                    android:minWidth="64dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/destination_series" />

                <Button
                    android:id="@+id/tabVideos"
                    style="@style/Btn.Tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginStart="2dp"
                    android:minWidth="64dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/destination_videos" />

                <Button
                    android:id="@+id/tabPhotos"
                    style="@style/Btn.Tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginStart="2dp"
                    android:minWidth="64dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/destination_photos" />

                <Button
                    android:id="@+id/tabAudio"
                    style="@style/Btn.Tab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginStart="2dp"
                    android:minWidth="64dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/destination_music" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/libraryContext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginTop="142dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/pluxyTextSecondary"
        android:textSize="16sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/swipeHint"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="142dp"
        android:background="@drawable/bg_gesture_hint"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/mobile_category_swipe_hint"
        android:textColor="?attr/pluxyTextSecondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Aperçu contextuel TV : la carte focalisée pilote cette zone. Caché sur téléphone. -->
    <FrameLayout
        android:id="@+id/libraryHero"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginTop="154dp"
        android:background="@drawable/bg_library_hero"
        android:clipToOutline="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/libraryHeroImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.42"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_library_hero" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="18dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/libraryHeroEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/pluxyTextSecondary"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/libraryHeroTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/pluxyTextPrimary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/libraryHeroMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/pluxyTextSecondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/screen_pad"
        android:layout_marginEnd="@dimen/screen_pad"
        android:layout_marginTop="174dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="6dp"
            android:paddingBottom="24dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:textColor="?attr/pluxyTextSecondary"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/emptyAction"
            style="@style/Btn.Primary"
            android:layout_marginTop="20dp"
            android:text="@string/action_find_server"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/mainLoading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminateTint="?attr/pluxyAccent"
        android:visibility="gone" />
</FrameLayout>
