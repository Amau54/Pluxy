<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:background="@drawable/bg_tv_ambient"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_pad"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/pluxy_logo"
            android:adjustViewBounds="true"
            android:contentDescription="@string/brand_pluxy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/server_setup_title"
            android:textColor="?attr/pluxyTextPrimary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/server_setup_scanning"
            android:textColor="?attr/pluxyTextSecondary"
            android:textSize="@dimen/details_meta_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/server_setup_trust_warning"
            android:textColor="?attr/pluxyTextSecondary"
            android:textSize="@dimen/details_caption_size" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:indeterminateTint="?attr/pluxyAccent" />

        <!-- Liste des serveurs découverts -->
        <LinearLayout
            android:id="@+id/serverList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_horizontal"
            android:orientation="vertical" />

        <Button
            android:id="@+id/rescan"
            style="@style/Btn.Secondary"
            android:layout_marginTop="18dp"
            android:text="@string/action_rescan" />

        <!-- Saisie manuelle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/server_setup_manual"
            android:textColor="?attr/pluxyTextTertiary"
            android:textSize="14sp"
            android:letterSpacing="0.02" />

        <EditText
            android:id="@+id/manualIp"
            android:layout_width="@dimen/server_address_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:hint="@string/server_setup_hint"
            android:importantForAutofill="no"
            android:textColorHint="?attr/pluxyTextTertiary"
            android:inputType="text"
            android:imeOptions="actionGo"
            android:minHeight="@dimen/btn_min_h"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="?attr/pluxyTextPrimary" />

        <Button
            android:id="@+id/connectManual"
            style="@style/Btn.Primary"
            android:layout_marginTop="14dp"
            android:text="@string/action_connect" />
    </LinearLayout>
</ScrollView>
