<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_auxiliary_controls"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:layoutDirection="ltr">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="4dp"
            android:textSize="@dimen/auxiliary_meta_size"
            android:textColor="?attr/pluxyTextSecondary" />
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:focusable="true"
            app:bar_height="2dp"
            app:touch_target_height="48dp"
            app:scrubber_enabled_size="6dp"
            app:scrubber_dragged_size="10dp"
            app:played_color="?attr/pluxyAccentBright"
            app:scrubber_color="?attr/pluxyAccentBright"
            app:buffered_color="?attr/pluxyTextTertiary"
            app:unplayed_color="?attr/pluxyBorderSubtle" />
        <TextView
            android:id="@id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="4dp"
            android:paddingEnd="6dp"
            android:textSize="@dimen/auxiliary_meta_size"
            android:textColor="?attr/pluxyTextSecondary" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:focusable="false">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageButton
                android:id="@id/exo_prev"
                style="@style/AuxiliaryViewer.Icon"
                android:src="@drawable/exo_icon_previous"
                android:contentDescription="@string/exo_controls_previous_description" />
            <ImageButton
                android:id="@id/exo_rew"
                style="@style/AuxiliaryViewer.Icon"
                android:src="@drawable/ic_player_rewind"
                android:contentDescription="@string/exo_controls_rewind_description" />
            <ImageButton
                android:id="@id/exo_play_pause"
                style="@style/AuxiliaryViewer.Icon"
                android:src="@drawable/ic_player_play"
                android:contentDescription="@string/exo_controls_play_description" />
            <ImageButton
                android:id="@id/exo_ffwd"
                style="@style/AuxiliaryViewer.Icon"
                android:src="@drawable/ic_player_forward"
                android:contentDescription="@string/exo_controls_fastforward_description" />
            <ImageButton
                android:id="@id/exo_next"
                style="@style/AuxiliaryViewer.Icon"
                android:src="@drawable/exo_icon_next"
                android:contentDescription="@string/exo_controls_next_description" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
