<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/focus_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:stateListAnimator="@animator/focus_lift_btn">

    <ImageView
        android:id="@+id/epThumbnail"
        android:layout_width="96dp"
        android:layout_height="54dp"
        android:background="@drawable/poster_rounded"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/epNum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/pluxyAccent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/epTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?attr/pluxyTextPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/epMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/pluxyTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/epWatched"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:contentDescription="@string/description_episode_watched"
            android:text="@string/label_watched_upper"
            android:textColor="?attr/pluxySuccess"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/epResume"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressDrawable="@drawable/resume_progress"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
