<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:background="@android:color/black"
        app:shutter_background_color="@android:color/black"
        app:keep_content_on_player_reset="true"
        app:resize_mode="fit"
        app:show_buffering="never"
        app:show_subtitle_button="false"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/playerLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:elevation="28dp"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateTint="?attr/pluxyAccentBright"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/player_controls_scrim"
        android:clickable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/playerTitleCapsule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/media_viewer_screen_pad"
            android:layout_marginTop="@dimen/player_edge_gap"
            android:layout_marginEnd="@dimen/media_viewer_screen_pad"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mediaTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#B3000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="?attr/pluxyTextPrimary"
                android:textSize="@dimen/player_title_size" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnExitPlayback"
            style="@style/PlayerDeck.Icon"
            android:layout_gravity="top|end"
            android:layout_marginTop="@dimen/player_edge_gap"
            android:layout_marginEnd="@dimen/media_viewer_screen_pad"
            android:contentDescription="@string/player_leave_action"
            android:nextFocusDown="@id/playbackTimeline"
            android:src="@drawable/ic_player_close"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/seekOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_player_title_glass"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/seekArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/pluxyAccentBright"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/seekTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/pluxyTextPrimary"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/seekDelta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/pluxyTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Le panneau peut défiler lorsque la police ou la hauteur réduit l'espace. -->
        <ScrollView
            android:id="@+id/playerPanelScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="@dimen/media_viewer_screen_pad"
            android:layout_marginEnd="@dimen/media_viewer_screen_pad"
            android:layout_marginBottom="@dimen/player_edge_gap"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="false"
            android:overScrollMode="never"
            android:scrollbarStyle="insideOverlay"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/playerBottomPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_player_deck_glass"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="@dimen/player_deck_padding"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/player_deck_padding"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/modeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:maxLines="2"
                    android:textColor="?attr/pluxyTextSecondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/timePosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/player_zero_time"
                        android:textColor="?attr/pluxyTextPrimary"
                        android:textSize="@dimen/player_time_size" />
                    <androidx.media3.ui.DefaultTimeBar
                        android:id="@+id/playbackTimeline"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/player_timeline_description"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/btnPlayPause"
                        app:bar_height="2dp"
                        app:buffered_color="?attr/pluxyPlayerBuffered"
                        app:played_color="?attr/pluxyAccentBright"
                        app:scrubber_color="?attr/pluxyAccentBright"
                        app:scrubber_dragged_size="14dp"
                        app:scrubber_enabled_size="6dp"
                        app:touch_target_height="48dp"
                        app:unplayed_color="?attr/pluxyPlayerUnplayed" />
                    <TextView
                        android:id="@+id/timeDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/player_zero_time"
                        android:textColor="?attr/pluxyTextSecondary"
                        android:textSize="@dimen/player_time_size" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/playerActionRows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/playerTransportRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp">
                        <ImageButton
                            android:id="@+id/btnRestart"
                            style="@style/PlayerDeck.Icon"
                            android:contentDescription="@string/player_restart"
                            android:nextFocusLeft="@id/btnForward"
                            android:nextFocusRight="@id/btnRewind"
                            android:nextFocusUp="@id/playbackTimeline"
                            android:nextFocusDown="@id/btnTracks"
                            android:src="@drawable/ic_player_restart" />
                        <ImageButton
                            android:id="@+id/btnRewind"
                            style="@style/PlayerDeck.Icon"
                            android:contentDescription="@string/player_rewind_description"
                            android:nextFocusLeft="@id/btnRestart"
                            android:nextFocusRight="@id/btnPlayPause"
                            android:nextFocusUp="@id/playbackTimeline"
                            android:nextFocusDown="@id/btnTracks"
                            android:src="@drawable/ic_player_skip_back_ten" />
                        <ImageButton
                            android:id="@+id/btnPlayPause"
                            style="@style/PlayerDeck.Primary"
                            android:contentDescription="@string/player_play_description"
                            android:nextFocusLeft="@id/btnRewind"
                            android:nextFocusRight="@id/btnForward"
                            android:nextFocusUp="@id/playbackTimeline"
                            android:nextFocusDown="@id/btnTracks"
                            android:src="@drawable/ic_player_play" />
                        <ImageButton
                            android:id="@+id/btnForward"
                            style="@style/PlayerDeck.Icon"
                            android:contentDescription="@string/player_forward_description"
                            android:nextFocusLeft="@id/btnPlayPause"
                            android:nextFocusRight="@id/btnRestart"
                            android:nextFocusUp="@id/playbackTimeline"
                            android:nextFocusDown="@id/btnSubtitles"
                            android:src="@drawable/ic_player_skip_forward_ten" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:id="@+id/playerSecondaryScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:fillViewport="true"
                        android:focusable="false"
                        android:overScrollMode="never"
                        android:scrollbars="none">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp">
                            <Button
                                android:id="@+id/btnTracks"
                                style="@style/PlayerDeck.Action"
                                android:contentDescription="@string/player_audio_action"
                                android:drawableStart="@drawable/ic_player_audio"
                                android:text="@string/player_audio_action"
                                android:nextFocusLeft="@id/btnGear"
                                android:nextFocusRight="@id/btnSubtitles"
                                android:nextFocusUp="@id/btnPlayPause"
                                android:nextFocusDown="@id/btnPlayPause" />
                            <Button
                                android:id="@+id/btnSubtitles"
                                style="@style/PlayerDeck.Action"
                                android:layout_marginStart="4dp"
                                android:contentDescription="@string/player_subtitles_action"
                                android:drawableStart="@drawable/ic_player_subtitles"
                                android:text="@string/player_subtitles_action"
                                android:nextFocusLeft="@id/btnTracks"
                                android:nextFocusRight="@id/btnGear"
                                android:nextFocusUp="@id/btnPlayPause"
                                android:nextFocusDown="@id/btnPlayPause" />
                            <ImageButton
                                android:id="@+id/btnGear"
                                style="@style/PlayerDeck.Icon"
                                android:layout_marginStart="4dp"
                                android:contentDescription="@string/player_more"
                                android:nextFocusLeft="@id/btnSubtitles"
                                android:nextFocusRight="@id/btnTracks"
                                android:nextFocusUp="@id/btnForward"
                                android:nextFocusDown="@id/btnForward"
                                android:src="@drawable/ic_more_horizontal" />
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginStart="@dimen/media_viewer_screen_pad"
        android:layout_marginTop="104dp"
        android:layout_marginEnd="@dimen/media_viewer_screen_pad"
        android:background="@drawable/bg_player_title_glass"
        android:elevation="24dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:maxWidth="560dp"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/pluxyInfo"
        android:textSize="14sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/playbackErrorPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/media_viewer_screen_pad"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/media_viewer_screen_pad"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_player_deck_glass"
        android:elevation="30dp"
        android:fillViewport="true"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_error_title"
                android:textColor="?attr/pluxyTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/playbackErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="480dp"
                android:textColor="?attr/pluxyTextSecondary"
                android:textSize="17sp" />
            <Button
                android:id="@+id/btnRetryPlayback"
                style="@style/PlayerDeck.Action"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:nextFocusLeft="@id/btnRetryPlayback"
                android:nextFocusRight="@id/btnRetryPlayback"
                android:nextFocusDown="@id/btnLeavePlayback"
                android:nextFocusUp="@id/btnLeavePlayback"
                android:text="@string/player_retry_action" />
            <Button
                android:id="@+id/btnLeavePlayback"
                style="@style/PlayerDeck.Action"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:nextFocusLeft="@id/btnLeavePlayback"
                android:nextFocusRight="@id/btnLeavePlayback"
                android:nextFocusUp="@id/btnRetryPlayback"
                android:nextFocusDown="@id/btnRetryPlayback"
                android:text="@string/player_leave_action" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
