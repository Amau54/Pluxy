<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp"
    android:background="@drawable/bg_next_episode_surface">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/player_next_episode" android:fontFamily="sans-serif-light"
        android:textColor="#C8FFFFFF" android:textSize="13sp" android:letterSpacing="0.08" />
    <ImageView android:id="@+id/nextEpisodeArtwork"
        android:layout_width="match_parent" android:layout_height="180dp" android:layout_marginTop="12dp"
        android:background="@drawable/bg_details_artwork" android:clipToOutline="true"
        android:scaleType="centerCrop" android:contentDescription="@null" android:importantForAccessibility="no" />
    <TextView android:id="@+id/nextEpisodeTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:fontFamily="sans-serif-medium" android:textColor="#F2FFFFFF" android:textSize="20sp"
        android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/nextEpisodeCode" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-light" android:textColor="#BFFFFFFF" android:textSize="12sp"
        android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/nextEpisodeCountdown" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light" android:textSize="15sp" android:textColor="#DDFFFFFF"
            android:accessibilityLiveRegion="none" />
        <Button android:id="@+id/nextEpisodeStay" style="@style/PlayerDeck.Action"
            android:layout_width="wrap_content" android:background="@null" android:backgroundTint="@null"
            android:fontFamily="sans-serif-medium" android:textColor="@color/player_skip_text"
            android:defaultFocusHighlightEnabled="false" android:text="@string/player_next_stay"
            android:nextFocusLeft="@id/nextEpisodeStay" android:nextFocusRight="@id/nextEpisodeStay"
            android:nextFocusUp="@id/nextEpisodeStay" android:nextFocusDown="@id/nextEpisodeStay" />
    </LinearLayout>
</LinearLayout>
