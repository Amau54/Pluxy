<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_next_episode_glass"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/player_next_episode"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/pluxyTextSecondary"
        android:textSize="12sp"
        android:letterSpacing="0.06" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/nextEpisodeArtwork"
            android:layout_width="96dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_details_artwork"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/nextEpisodeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/pluxyTextPrimary"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/nextEpisodeCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/pluxyTextSecondary"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/nextEpisodeCountdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?attr/pluxyTextSecondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/nextEpisodePlay"
            style="@style/PlayerDeck.Action"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_next_episode_play"
            android:text="@string/player_next_now"
            android:nextFocusLeft="@id/nextEpisodeStay"
            android:nextFocusRight="@id/nextEpisodeStay"
            android:nextFocusUp="@id/nextEpisodePlay"
            android:nextFocusDown="@id/nextEpisodePlay" />
        <Button
            android:id="@+id/nextEpisodeStay"
            style="@style/PlayerDeck.Action"
            android:layout_marginStart="8dp"
            android:text="@string/player_next_stay"
            android:nextFocusLeft="@id/nextEpisodePlay"
            android:nextFocusRight="@id/nextEpisodePlay"
            android:nextFocusUp="@id/nextEpisodeStay"
            android:nextFocusDown="@id/nextEpisodeStay" />
    </LinearLayout>
</LinearLayout>
