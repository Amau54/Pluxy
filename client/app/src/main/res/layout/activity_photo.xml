<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/description_photo"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="fitCenter" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <!-- Visible on entry, then reachable with OK or up/down on every TV remote. -->
    <LinearLayout
        android:id="@+id/photoInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/media_viewer_screen_pad"
        android:layout_marginEnd="@dimen/media_viewer_screen_pad"
        android:layout_marginBottom="34dp"
        android:background="@drawable/bg_photo_info"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/photoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="640dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/photoIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/photoStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/photo_slideshow_active"
            android:textColor="@color/accent_bright"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/photoError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPhotoRetry"
            style="@style/PlayerControl.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nextFocusDown="@id/btnPhotoSlideshow"
            android:nextFocusUp="@id/btnPhotoRetry"
            android:text="@string/action_retry"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/photoControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPhotoPrevious"
                style="@style/PlayerControl.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:nextFocusLeft="@id/btnPhotoNext"
                android:nextFocusRight="@id/btnPhotoSlideshow"
                android:nextFocusUp="@id/btnPhotoPrevious"
                android:nextFocusDown="@id/btnPhotoPrevious"
                android:text="@string/photo_previous_action" />

            <Button
                android:id="@+id/btnPhotoSlideshow"
                style="@style/PlayerControl.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:nextFocusLeft="@id/btnPhotoPrevious"
                android:nextFocusRight="@id/btnPhotoNext"
                android:nextFocusUp="@id/btnPhotoRetry"
                android:nextFocusDown="@id/btnPhotoSlideshow"
                android:text="@string/photo_slideshow_start" />

            <Button
                android:id="@+id/btnPhotoNext"
                style="@style/PlayerControl.Secondary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:nextFocusLeft="@id/btnPhotoSlideshow"
                android:nextFocusRight="@id/btnPhotoPrevious"
                android:nextFocusUp="@id/btnPhotoNext"
                android:nextFocusDown="@id/btnPhotoNext"
                android:text="@string/photo_next_action" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/photo_remote_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/photoHintLeft"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="32dp"
        android:background="@drawable/bg_photo_edge_hint"
        android:contentDescription="@null"
        android:padding="15dp"
        android:src="@drawable/ic_chevron_left" />

    <ImageView
        android:id="@+id/photoHintRight"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_photo_edge_hint"
        android:contentDescription="@null"
        android:padding="15dp"
        android:src="@drawable/ic_chevron_right" />
</FrameLayout>
