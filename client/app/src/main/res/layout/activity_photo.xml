<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fitsSystemWindows="true" android:background="@android:color/black">

    <ImageView android:id="@+id/photo"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:contentDescription="@string/description_photo"
        android:focusable="true" android:clickable="true" android:scaleType="fitCenter" />
    <ProgressBar android:id="@+id/loading"
        android:layout_width="32dp" android:layout_height="32dp"
        android:layout_gravity="center" android:indeterminateTint="?attr/pluxyAccent" />

    <LinearLayout android:id="@+id/photoInfo"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/media_viewer_screen_pad"
        android:layout_marginEnd="@dimen/media_viewer_screen_pad"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_auxiliary_controls" android:orientation="vertical"
        android:paddingStart="12dp" android:paddingEnd="4dp"
        android:paddingTop="4dp" android:paddingBottom="4dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="4dp" android:orientation="vertical">
                <TextView android:id="@+id/photoTitle"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:ellipsize="end" android:maxLines="1"
                    android:textColor="?attr/pluxyTextPrimary"
                    android:textSize="@dimen/auxiliary_meta_size" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/photoIndex"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:textColor="?attr/pluxyTextSecondary"
                    android:textSize="@dimen/auxiliary_meta_size" />
                <TextView android:id="@+id/photoStatus"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end"
                    android:text="@string/photo_slideshow_active" android:textColor="?attr/pluxyAccentBright"
                    android:textSize="@dimen/auxiliary_meta_size" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/photoControls"
                android:layout_width="wrap_content" android:layout_height="48dp"
                android:gravity="center" android:orientation="horizontal">
                <ImageButton android:id="@+id/btnPhotoPrevious" style="@style/AuxiliaryViewer.Icon"
                    android:src="@drawable/ic_chevron_left" android:contentDescription="@string/photo_previous_action"
                    android:nextFocusLeft="@id/btnPhotoNext" android:nextFocusRight="@id/btnPhotoSlideshow"
                    android:nextFocusUp="@id/btnPhotoPrevious" android:nextFocusDown="@id/btnPhotoPrevious" />
                <ImageButton android:id="@+id/btnPhotoSlideshow" style="@style/AuxiliaryViewer.Icon"
                    android:src="@drawable/ic_player_play" android:contentDescription="@string/photo_slideshow_start"
                    android:nextFocusLeft="@id/btnPhotoPrevious" android:nextFocusRight="@id/btnPhotoNext"
                    android:nextFocusUp="@id/btnPhotoRetry" android:nextFocusDown="@id/btnPhotoSlideshow" />
                <ImageButton android:id="@+id/btnPhotoNext" style="@style/AuxiliaryViewer.Icon"
                    android:src="@drawable/ic_chevron_right" android:contentDescription="@string/photo_next_action"
                    android:nextFocusLeft="@id/btnPhotoSlideshow" android:nextFocusRight="@id/btnPhotoPrevious"
                    android:nextFocusUp="@id/btnPhotoNext" android:nextFocusDown="@id/btnPhotoNext" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/photoError"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite"
            android:textColor="?attr/pluxyTextPrimary" android:textSize="@dimen/auxiliary_meta_size"
            android:visibility="gone" />
        <Button android:id="@+id/btnPhotoRetry" style="@style/AuxiliaryViewer.Action"
            android:layout_width="wrap_content" android:layout_marginTop="4dp"
            android:nextFocusDown="@id/btnPhotoSlideshow" android:nextFocusUp="@id/btnPhotoRetry"
            android:text="@string/action_retry" android:visibility="gone" />
    </LinearLayout>

    <ImageButton android:id="@+id/btnPhotoClose" style="@style/AuxiliaryViewer.Icon"
        android:layout_gravity="top|end" android:layout_marginEnd="@dimen/media_viewer_screen_pad"
        android:layout_marginTop="12dp" android:src="@drawable/ic_player_close"
        android:contentDescription="@string/player_leave_action" android:background="@drawable/bg_auxiliary_controls"
        android:visibility="gone" />
    <ImageView android:id="@+id/photoHintLeft"
        android:layout_width="32dp" android:layout_height="32dp"
        android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp"
        android:background="@drawable/bg_photo_edge_hint" android:contentDescription="@null"
        android:importantForAccessibility="no" android:padding="8dp" android:src="@drawable/ic_chevron_left" />
    <ImageView android:id="@+id/photoHintRight"
        android:layout_width="32dp" android:layout_height="32dp"
        android:layout_gravity="center_vertical|end" android:layout_marginEnd="16dp"
        android:background="@drawable/bg_photo_edge_hint" android:contentDescription="@null"
        android:importantForAccessibility="no" android:padding="8dp" android:src="@drawable/ic_chevron_right" />
</FrameLayout>
