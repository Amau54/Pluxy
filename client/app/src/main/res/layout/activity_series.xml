<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_tv_ambient">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:alpha="0.35"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        />

    <View
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:background="@drawable/scrim_backdrop" />

    <LinearLayout
        android:id="@+id/seriesContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_pad"
        android:paddingEnd="@dimen/screen_pad"
        android:paddingTop="@dimen/details_top_pad"
        android:paddingBottom="24dp">

        <ScrollView
            android:id="@+id/seriesHeaderScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/seriesHeaderContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/seriesTitle"
                    style="@style/Text.Display"
                    android:textSize="@dimen/details_title_size"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/seriesSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/pluxyTextSecondary"
                    android:textSize="@dimen/auxiliary_meta_size" />

                <LinearLayout
                    android:id="@+id/seriesActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipChildren="false">
                    <Button
                        android:id="@+id/continueEpisode"
                        style="@style/Btn.Primary"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:nextFocusRight="@id/seriesTrailer"
                        android:visibility="gone" />
                    <Button
                        android:id="@+id/seriesTrailer"
                        style="@style/Btn.Secondary"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:text="@string/action_trailer"
                        android:nextFocusLeft="@id/continueEpisode"
                        android:visibility="gone" />
                    <Button android:id="@+id/seriesMetadataFix" style="@style/Btn.Secondary"
                        android:layout_width="48dp" android:layout_height="48dp"
                        android:layout_marginStart="8dp" android:text="" android:contentDescription="Corriger les informations"
                        android:drawableTop="@drawable/ic_player_symbol_more" android:padding="12dp" />
                </LinearLayout>

                <!-- Notes multi-sites (TMDB / IMDb / Rotten Tomatoes / Metacritic) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/seriesRatings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/seriesOverview"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:maxWidth="640dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone" />



            </LinearLayout>
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/seasonScroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/seasons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/episodesLabel"
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_episodes" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/seriesLoading"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:indeterminateTint="?attr/pluxyAccent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/seriesMessage"
                    style="@style/Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxWidth="560dp"
                    android:textColor="?attr/pluxyTextSecondary"
                    android:textSize="18sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/seriesRetry"
                    style="@style/Btn.Secondary"
                    android:layout_marginTop="16dp"
                    android:text="@string/action_retry"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
