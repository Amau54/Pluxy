<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/pluxy_bg"
                android:centerColor="@color/pluxy_ambient_center"
                android:startColor="@color/pluxy_ambient_top" />
        </shape>
    </item>
    <item android:gravity="top|right" android:right="-120dp" android:top="-180dp">
        <shape android:shape="oval">
            <size android:width="420dp" android:height="420dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:startColor="@color/pluxy_glow_coral"
                android:endColor="@color/pluxy_glow_coral_end" />
        </shape>
    </item>
    <item android:gravity="bottom|left" android:left="-160dp" android:bottom="-200dp">
        <shape android:shape="oval">
            <size android:width="500dp" android:height="500dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="250dp"
                android:startColor="@color/pluxy_glow_blue"
                android:endColor="@color/pluxy_glow_blue_end" />
        </shape>
    </item>
</layer-list>
