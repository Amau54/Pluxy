<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/server_pluxy_glass_pressed" />
            <corners android:radius="@dimen/server_radius_lg" />
            <stroke android:width="1dp" android:color="@color/server_pluxy_accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/server_pluxy_glass_pressed" />
            <corners android:radius="@dimen/server_radius_lg" />
            <stroke android:width="1dp" android:color="@color/server_pluxy_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="@color/server_pluxy_glass_reflection" android:endColor="@color/server_pluxy_glass_base" />
            <corners android:radius="@dimen/server_radius_lg" />
            <stroke android:width="0.5dp" android:color="@color/server_pluxy_glass_stroke" />
        </shape>
    </item>
</selector>
