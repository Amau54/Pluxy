<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/server_pluxy_glass_pressed" />
            <stroke android:width="1dp" android:color="@color/server_pluxy_accent" />
            <corners android:radius="@dimen/server_radius_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/server_pluxy_glass_pressed" />
            <corners android:radius="@dimen/server_radius_md" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/server_radius_md" />
        </shape>
    </item>
</selector>
