<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/server_bg_button_secondary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/mediaKind"
        android:layout_width="28dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:padding="3dp"
        android:scaleType="centerInside"
        app:tint="@color/server_pluxy_accent"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mediaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/server_pluxy_text"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/mediaDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/server_pluxy_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mediaSelected"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:src="@drawable/server_ic_check"
        app:tint="@color/server_pluxy_accent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</LinearLayout>
