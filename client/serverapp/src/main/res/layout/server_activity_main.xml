<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/server_bg_server_ambient"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Logo Pluxy"
                    android:src="@drawable/server_ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pluxy Serveur"
                        android:textColor="@color/server_pluxy_text"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Votre téléphone devient une médiathèque"
                        android:textColor="@color/server_pluxy_muted"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/server_bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SERVEUR"
                        android:textColor="@color/server_pluxy_muted"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                    <TextView
                        android:id="@+id/statusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/server_bg_status"
                        android:text="●  Arrêté"
                        android:textColor="@color/server_pluxy_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/serverAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Indisponible"
                    android:textColor="@color/server_pluxy_text"
                    android:textIsSelectable="true"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/serverSummary"
                    android:accessibilityLiveRegion="polite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Prêt à démarrer"
                    android:textColor="@color/server_pluxy_muted"
                    android:textSize="13sp" />

                <ProgressBar
                    android:id="@+id/startProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/server_pluxy_accent"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/serverToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/server_bg_button_primary"
                    android:text="Démarrer le serveur"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_on_accent"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />

                <Button
                    android:id="@+id/sendToTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/server_bg_button_cast"
                    android:text="Envoyer Cast"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_on_accent"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <Button
                android:id="@+id/optionsToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/server_bg_button_secondary"
                android:text="Options"
                android:textAllCaps="false"
                android:textColor="@color/server_pluxy_text"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/server_bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <Button android:id="@+id/changeApplicationMode"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:text="Mode de l’application · Serveur"
                    android:textAllCaps="false" android:textColor="@color/server_pluxy_text"
                    android:background="@drawable/server_bg_button_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MÉDIAS"
                    android:textColor="@color/server_pluxy_accent_bright"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoDiscover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/server_bg_option"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Détecter mes médias"
                    android:textColor="@color/server_pluxy_text"
                    android:textSize="15sp"
                    app:thumbTint="@color/server_pluxy_accent"
                    app:trackTint="@color/server_pluxy_glass_stroke" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="DOSSIERS MANUELS"
                    android:textColor="@color/server_pluxy_muted"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ajoutez un ou plusieurs dossiers par thème."
                    android:textColor="@color/server_pluxy_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/chooseFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/server_bg_button_secondary"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Films et séries · ajouter ou gérer"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_text" />

                <TextView
                    android:id="@+id/folderPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Aucun dossier"
                    android:textColor="@color/server_pluxy_muted"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/choosePhotoFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/server_bg_button_secondary"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Images · ajouter ou gérer"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_text" />

                <TextView
                    android:id="@+id/photoFolderPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Aucun dossier"
                    android:textColor="@color/server_pluxy_muted"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chooseAudioFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/server_bg_button_secondary"
                    android:gravity="start|center_vertical"
                    android:paddingStart="12dp"
                    android:text="Musique · ajouter ou gérer"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_text" />

                <TextView
                    android:id="@+id/audioFolderPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Aucun dossier"
                    android:textColor="@color/server_pluxy_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="SERVEUR"
                    android:textColor="@color/server_pluxy_accent_bright"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />

                <EditText
                    android:id="@+id/serverName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/server_bg_input"
                    android:hint="Nom du serveur"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textColor="@color/server_pluxy_text"
                    android:textColorHint="@color/server_pluxy_muted" />

                <Button
                    android:id="@+id/tmdbHelpToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/server_bg_button_secondary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="À quoi sert TMDB ?"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tmdbHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/server_bg_option"
                    android:padding="14dp"
                    android:text="TMDB ajoute affiches, synopsis et informations pour les films et séries. La lecture fonctionne sans cette clé.\n\nPour l’activer : créez un compte gratuit sur themoviedb.org, ouvrez Réglages › API, créez une clé API (v3), puis collez-la ci-dessus."
                    android:textColor="@color/server_pluxy_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/tmdbKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/server_bg_input"
                    android:hint="Clé TMDB — facultatif"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textSize="14sp"
                    android:textColor="@color/server_pluxy_text"
                    android:textColorHint="@color/server_pluxy_muted" />

                <TextView
                    android:id="@+id/tmdbStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/server_pluxy_muted"
                    android:textSize="12sp"
                    android:accessibilityLiveRegion="polite" />

                <Button
                    android:id="@+id/refreshTmdb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="6dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/server_bg_button_secondary"
                    android:text="Actualiser les affiches"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_text"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/keepAwake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/server_bg_option"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Actif écran éteint"
                    android:textColor="@color/server_pluxy_text"
                    android:textSize="15sp"
                    app:thumbTint="@color/server_pluxy_accent"
                    app:trackTint="@color/server_pluxy_glass_stroke" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoStart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/server_bg_option"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Démarrer avec le téléphone"
                    android:textColor="@color/server_pluxy_text"
                    android:textSize="15sp"
                    app:thumbTint="@color/server_pluxy_accent"
                    app:trackTint="@color/server_pluxy_glass_stroke" />

                <Button
                    android:id="@+id/rescan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/server_bg_button_secondary"
                    android:text="Actualiser les médias"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_text" />

                <Button
                    android:id="@+id/copyAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/server_bg_button_secondary"
                    android:text="Copier l’adresse"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_text" />

                <Button
                    android:id="@+id/batterySettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/server_bg_button_secondary"
                    android:text="Réglages batterie"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_text" />

                <Button
                    android:id="@+id/privacyPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/server_bg_button_secondary"
                    android:text="Confidentialité et crédits"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textColor="@color/server_pluxy_text" />

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Logo TMDB"
                    android:src="@drawable/server_tmdb_logo" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
