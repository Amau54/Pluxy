<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_server_ambient"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:contentDescription="Logo Pluxy"
                    android:src="@drawable/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pluxy Serveur"
                        android:textColor="@color/pluxy_text"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Votre téléphone devient une médiathèque"
                        android:textColor="@color/pluxy_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status"
                    android:text="●  Arrêté"
                    android:textColor="@color/pluxy_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SERVEUR"
                    android:textColor="@color/pluxy_accent_bright"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/serverAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Indisponible"
                    android:textColor="@color/pluxy_text"
                    android:textIsSelectable="true"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/serverSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="2"
                    android:text="Prêt à démarrer"
                    android:textColor="@color/pluxy_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/serverToggle"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_button_primary"
                    android:text="Démarrer le serveur"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_on_accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/sendToTv"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_button_cast"
                    android:text="Envoyer Cast"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_on_accent"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/optionsToggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:text="Options"
                android:textAllCaps="false"
                android:textColor="@color/pluxy_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/optionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MÉDIAS"
                    android:textColor="@color/pluxy_accent_bright"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoDiscover"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_option"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:text="Détecter mes médias"
                    android:textColor="@color/pluxy_text"
                    android:textSize="15sp"
                    app:thumbTint="@color/pluxy_accent"
                    app:trackTint="@color/pluxy_glass_stroke" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="DOSSIERS MANUELS"
                    android:textColor="@color/pluxy_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ajoutez un ou plusieurs dossiers par thème."
                    android:textColor="@color/pluxy_muted"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/chooseFolder"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="Films et séries · ajouter ou gérer"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_text" />

                <TextView
                    android:id="@+id/folderPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Aucun dossier"
                    android:textColor="@color/pluxy_muted"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/choosePhotoFolder"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="Images · ajouter ou gérer"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_text" />

                <TextView
                    android:id="@+id/photoFolderPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Aucun dossier"
                    android:textColor="@color/pluxy_muted"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/chooseAudioFolder"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_secondary"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:text="Musique · ajouter ou gérer"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_text" />

                <TextView
                    android:id="@+id/audioFolderPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Aucun dossier"
                    android:textColor="@color/pluxy_muted"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="SERVEUR"
                    android:textColor="@color/pluxy_accent_bright"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/serverName"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="Nom du serveur"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/pluxy_text"
                    android:textColorHint="@color/pluxy_muted" />

                <Button
                    android:id="@+id/tmdbHelpToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="À quoi sert TMDB ?"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tmdbHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_option"
                    android:padding="14dp"
                    android:text="TMDB ajoute affiches, synopsis et informations pour les films et séries. La lecture fonctionne sans cette clé.\n\nPour l’activer : créez un compte gratuit sur themoviedb.org, ouvrez Réglages › API, créez une clé API (v3), puis collez-la ci-dessus."
                    android:textColor="@color/pluxy_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/tmdbKey"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_input"
                    android:hint="Clé TMDB — facultatif"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/pluxy_text"
                    android:textColorHint="@color/pluxy_muted" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/keepAwake"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_option"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:text="Actif écran éteint"
                    android:textColor="@color/pluxy_text"
                    android:textSize="15sp"
                    app:thumbTint="@color/pluxy_accent"
                    app:trackTint="@color/pluxy_glass_stroke" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/autoStart"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_option"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp"
                    android:text="Démarrer avec le téléphone"
                    android:textColor="@color/pluxy_text"
                    android:textSize="15sp"
                    app:thumbTint="@color/pluxy_accent"
                    app:trackTint="@color/pluxy_glass_stroke" />

                <Button
                    android:id="@+id/rescan"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="Actualiser les médias"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_text" />

                <Button
                    android:id="@+id/copyAddress"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="Copier l’adresse"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_text" />

                <Button
                    android:id="@+id/batterySettings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="Réglages batterie"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_text" />

                <Button
                    android:id="@+id/privacyPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:text="Confidentialité et crédits"
                    android:textAllCaps="false"
                    android:textColor="@color/pluxy_text" />

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Logo TMDB"
                    android:src="@drawable/tmdb_logo" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
