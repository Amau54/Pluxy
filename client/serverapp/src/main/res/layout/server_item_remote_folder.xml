<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginTop="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/folderChevron"
        android:layout_width="28dp"
        android:layout_height="match_parent"
        android:padding="5dp"
        android:scaleType="centerInside"
        android:src="@drawable/server_ic_chevron_down"
        app:tint="@color/server_pluxy_accent"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/server_ic_folder"
        app:tint="@color/server_pluxy_accent"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/folderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/server_pluxy_text"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/folderCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/server_pluxy_muted"
        android:textSize="12sp" />
</LinearLayout>
